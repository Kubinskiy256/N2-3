<Window x:Class="staff_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="470" Width="620" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="authTextBlock" Grid.Row="0" FontSize="14" HorizontalAlignment="Right"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Введите фамилию:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <TextBox x:Name="searchBox" Width="260" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="searchButton" Content="Искать" Width="85" Height="26" Click="searchButton_Click"/>
        </StackPanel>

        <DataGrid x:Name="userTable" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" 
                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>